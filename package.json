  "dependencies": {
    "glob": "^13.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@rstest/core": "^0.11.4",
    "@rstest/coverage-v8": "^0.11.4",
    "@types/node": "^26.1.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3",
    "yaml": "^2.9.0"
